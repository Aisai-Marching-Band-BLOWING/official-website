---
interface Props {
  fileId: string;
  title?: string;
}

const { fileId, title = "PDFドキュメント" } = Astro.props;
---

<iframe
  class="pdf-viewer"
  title={title}
  loading="lazy"
  src={`https://drive.google.com/file/d/${fileId}/preview`}></iframe>

<style>
  .pdf-viewer {
    margin-top: calc(var(--ratio) * 1rem);
    width: 100%;
    height: min((100dvw - 3rem) * 1.414, 80dvh);
  }
</style>
