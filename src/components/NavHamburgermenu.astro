---
import NavLink from "./NavLink.astro";
---

<button
  type="button"
  aria-label="メニューを開く"
  class="hamburger"
  id="hamburger"
  aria-controls="menu"
  aria-expanded="false"
>
  <span class="hamburger-status" id="hamburger-status" aria-hidden="true">MENU</span>

  <div class="hamburger-lines">
    <span class="line"></span>
    <span class="line"></span>
    <span class="line"></span>
  </div>
</button>

<div class="menu" id="menu">
  <ul class="menu-list">
    <li class="menu-list-item"><NavLink href="/">ホーム</NavLink></li>
    <li class="menu-list-item"><NavLink href="/news/">お知らせ</NavLink></li>
    <li class="menu-list-item"><NavLink href="/about/">概要</NavLink></li>
    <li class="menu-list-item"><NavLink href="/join/">メンバー募集</NavLink></li>
    <li class="menu-list-item"><NavLink href="/contact/">お問い合わせ</NavLink></li>
    <li class="menu-list-item"><NavLink href="/privacy/">当サイトについて</NavLink></li>
  </ul>
</div>

<script>
  import "@/scripts/menu.ts";
</script>

<style>
  .menu-list-item {
    list-style: none;
  }

  @media (width < 960px) {
    .hamburger {
      display: grid;
      place-content: center;
      place-items: center;
      height: var(--nav-height);
      width: var(--nav-height);
      transition:
        background-color 0.4s,
        color 0.4s;
      background-color: rgb(var(--brand-rgb));
      color: rgb(var(--white-rgb));

      &:where(.nav-expanded &) {
        background-color: rgb(var(--white-rgb));
        color: rgb(var(--brand-rgb));
      }
    }

    .hamburger-status {
      font-size: 10px;
    }

    .line {
      display: block;
      height: 2px;
      width: 30px;
      margin: 5px 0;
      transition:
        transform 0.4s,
        opacity 0.4s,
        background-color 0.4s;
      background-color: rgb(var(--white-rgb));

      &:where(.nav-expanded &) {
        background-color: rgb(var(--brand-rgb));

        &:nth-child(1) {
          transform: translateY(7px) rotate(45deg);
        }

        &:nth-child(2) {
          opacity: 0;
        }

        &:nth-child(3) {
          transform: translateY(-7px) rotate(-45deg);
        }
      }
    }

    .menu {
      height: 100%;
      position: fixed;
      top: var(--nav-height);
      right: 0;
      translate: 100% 0;
      transition: translate 0.5s;
      background-color: rgb(var(--shippo-bg-rgb));
      background-image: var(--shippo-pattern-img);
      background-size: var(--shippo-pattern-size);
      overflow: auto;

      &:where(.nav-expanded &) {
        translate: 0 0;
      }

      @media (width < 640px) {
        width: 80%;
      }

      @media (640px <= width) {
        width: 50%;
      }
    }

    .menu-list {
      margin: 1.5rem;
      display: grid;
      gap: 1rem;
    }
  }

  @media (960px <= width) {
    .hamburger {
      display: none;
    }

    .menu-list {
      margin-block: 40px;
    }
  }
</style>
